[
  {
    "case_id": "sample_01_cancel_pending_reference",
    "task_id": "sample_01_cancel_pending",
    "kind": "reference",
    "expected_native_reward": 1.0,
    "expected_fixture_audit": true,
    "explanation": "Hand-authored reference trajectory; tools execute on a fresh synthetic database.",
    "events": [
      {
        "role": "user",
        "content": "Cancel order #W8100001; it is no longer needed. My email is asha@example.test."
      },
      {
        "role": "tool",
        "name": "find_user_id_by_email",
        "arguments": {
          "email": "asha@example.test"
        }
      },
      {
        "role": "tool",
        "name": "get_user_details",
        "arguments": {
          "user_id": "demo_asha_1001"
        }
      },
      {
        "role": "tool",
        "name": "get_order_details",
        "arguments": {
          "order_id": "#W8100001"
        }
      },
      {
        "role": "assistant",
        "content": "Cancel #W8100001 because it is no longer needed; refund 40.00 to original card ending 0000 in 5 to 7 business days. Do you confirm?"
      },
      {
        "role": "user",
        "content": "Yes, proceed with that action."
      },
      {
        "role": "tool",
        "name": "cancel_pending_order",
        "arguments": {
          "order_id": "#W8100001",
          "reason": "no longer needed"
        }
      },
      {
        "role": "assistant",
        "content": "Order #W8100001 is cancelled. The refund to your original card takes 5 to 7 business days."
      }
    ]
  },
